# Port du serveur
PORT=5050

# Compte Gmail dédié à la cellule (validation en 2 étapes activée)
# Créer un "mot de passe d'application" : Compte Google > Sécurité > Mots de passe des applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=asebem.nationale@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Boîte qui reçoit les messages (lue uniquement par les référents)
MAIL_TO=asebem.nationale@gmail.com

# Mettre à true pour tester sans envoyer d'email (le message s'affiche dans la console)
DRY_RUN=false

# Adresse(s) du front autorisées à appeler l'API, séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,https://cellule-ecoute-asebem.vercel.app
